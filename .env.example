# ==============================================================================
# ERP San Isaac - Variables de Entorno de Ejemplo
# ==============================================================================

# FUENTE DE DATOS DEL ERP
# Valores soportados: "mock" (por defecto en Fase 1) o "prisma" (punto de extension)
DATA_SOURCE="mock"

# ------------------------------------------------------------------------------
# BASE DE DATOS (Supabase Postgres)
# ------------------------------------------------------------------------------
# Transaction Pooler (puerto 6543) para Next.js / Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexion directa (puerto 5432) o Session Pooler para migraciones de Prisma
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# AUTENTICACION (NextAuth v4)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="tu-clave-secreta-de-al-menos-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE API & SDK
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder"

# ------------------------------------------------------------------------------
# SEED ADMINISTRADOR INICIAL
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@velassanisaac.com"
SEED_ADMIN_PASSWORD="CambiaEstaPasswordSegura2026!"
